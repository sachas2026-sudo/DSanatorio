# Copiá a panel-server/.env y ajustá valores (no subir .env a git)

# Puerto local (internet: reverse proxy HTTPS → este puerto)
PANEL_PORT=3780

# Token que usa la app de escritorio al publicar (mismo valor en Configuración → Panel)
PANEL_SYNC_SECRET=cambiar-por-token-largo-aleatorio

# Contraseña que usa el gerente para ver el panel web
PANEL_VIEW_PASSWORD=cambiar-clave-gerente

# En producción con HTTPS: PANEL_SECURE_COOKIE=1
# PANEL_SECURE_COOKIE=1
