{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sanatorio V",
  "version": "15.0.0",
  "identifier": "com.sanatorio.gestion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Centro Medico — Gestión",
        "width": 2000,
        "height": 1020,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "installer-bases/sanatorio-datos.json": "sanatorio-datos.json",
      "installer-bases/sanatorio-datos.respaldo-1.json": "sanatorio-datos.respaldo-1.json",
      "installer-bases/sanatorio-datos.respaldo-2.json": "sanatorio-datos.respaldo-2.json",
      "installer-bases/sanatorio-datos.respaldo-3.json": "sanatorio-datos.respaldo-3.json"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./nsis/installer-hooks.nsh",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Sanatorio"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
