{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ventana principal: datos vía comandos Rust; sin acceso fs amplio desde el webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
