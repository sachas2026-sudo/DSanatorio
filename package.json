{
  "name": "sanatorio",
  "private": true,
  "version": "16.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "installer:sync-bases": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-installer-bases.ps1",
    "installer:empty-bases": "node scripts/write-empty-installer-bases.mjs",
    "installer:ensure-logo": "node scripts/ensure-logo.mjs",
    "installer:build": "npm run installer:sync-bases && npm run desktop:build",
    "installer:build-clean": "npm run installer:ensure-logo && npm run installer:empty-bases && npm run desktop:build",
    "installer:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-all-installers.ps1",
    "installer:release": "npm run installer:build-clean && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-installer-to.ps1 -Version 5.0.0 -DestDir C:\\Proyectos\\Instaladores\\Sanatorio -Actualizacion",
    "package:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/zip-source-dotnet.ps1 -Version 2.2.1 -OutputDir C:\\Sanatorio -KeepMaxVersions 2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.3",
    "googleapis": "^173.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.7"
  }
}
